{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pacidekor-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "pacidekor-product-images"
    }
  ],
  "routes": [
    {
      "pattern": "media.pacidekor.sk/*",
      "zone_name": "pacidekor.sk"
    }
  ]
}
